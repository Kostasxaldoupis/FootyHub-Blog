---
const { title, date, author } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Football Blog</title>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a1928 0%, #0d1f2d 100%);
            color: #e2e8f0;
            line-height: 1.7;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
        }

        .back-link {
            display: inline-block;
            color: #60a5fa;
            text-decoration: none;
            margin-bottom: 2rem;
            transition: all 0.2s ease;
        }

        .back-link:hover {
            color: #93c5fd;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 0.5rem;
        }

        .meta {
            color: #94a3b8;
            border-bottom: 1px solid rgba(59, 130, 246, 0.3);
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }

        h2 {
            color: #93c5fd;
            margin: 1.5rem 0 0.75rem 0;
            border-left: 3px solid #3b82f6;
            padding-left: 1rem;
        }

        p {
            margin-bottom: 1rem;
        }

        a {
            color: #60a5fa;
            text-decoration: none;
        }

        a:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

        ul, ol {
            margin: 1rem 0 1rem 1.5rem;
        }

        li {
            margin: 0.3rem 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to all articles</a>
        
        <h1>{title}</h1>
        <div class="meta">
            {date && <span>📅 {date}</span>}
            {author && <span> ✍️ {"Konstantinos Chaldoupis"}</span>}
        </div>
        
        <article>
            <slot />
        </article>
    </div>
</body>
</html>