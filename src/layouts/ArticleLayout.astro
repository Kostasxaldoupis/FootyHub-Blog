---
import Footer from "../components/Astro/Footer.astro";
import Navbar from "../components/Astro/Navbar.astro";

const { title, date, author, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Football Blog</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0a1928;
        color: #e2e8f0;
        line-height: 1.7;
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }

      .back-link {
        display: inline-block;
        color: #60a5fa;
        text-decoration: none;
        margin-bottom: 2rem;
        transition: all 0.2s ease;
      }

      .back-link:hover {
        color: #93c5fd;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 0.5rem;
      }

      .meta {
        color: #94a3b8;
        border-bottom: 1px solid rgba(59, 130, 246, 0.3);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
      }

      h2 {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Color Emoji", "Apple Color Emoji", sans-serif;
        color: #93c5fd;
        margin: 1.5rem 0 0.75rem 0;
        border-left: 3px solid #3b82f6;
        padding-left: 1rem;
      }

      :global(article p) {
        margin-bottom: 1.5rem;
      }

      a {
        color: #60a5fa;
        text-decoration: none;
      }

      a:hover {
        color: #93c5fd;
        text-decoration: underline;
      }

      ul,
      ol {
        margin: 1rem 0 1rem 1.5rem;
      }

      li {
        margin: 0.3rem 0;
      }

      /* Match Recap Component Styles */
      .match-recap {
        background: #1e293b;
        border-radius: 20px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        border: 1px solid rgba(59, 130, 246, 0.3);
      }

      .league-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(59, 130, 246, 0.3);
      }

      .league-logo {
        width: 24px;
        height: 24px;
        object-fit: contain;
      }

      .league-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: #93c5fd;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .matchday {
        font-size: 0.75rem;
        color: #64748b;
        background: #0f172a;
        padding: 0.2rem 0.5rem;
        border-radius: 12px;
      }

      .match-scoreboard {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .team {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .home {
        justify-content: flex-start;
      }

      .away {
        justify-content: flex-end;
      }

      .team-logo {
        width: 28px !important;
        height: 28px !important;
        object-fit: contain;
      }

      .team-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #f1f5f9;
      }

      .team-score {
        font-size: 2.5rem;
        font-weight: 800;
        color: #fbbf24;
        min-width: 50px;
        text-align: center;
      }

      .score-separator {
        font-size: 1.5rem;
        font-weight: 700;
        color: #475569;
        padding: 0 0.5rem;
      }

      .match-date {
        text-align: center;
        margin-top: 1rem;
        font-size: 0.8rem;
        color: #64748b;
      }

      /* Article Navigation Footer Styles */
      .article-footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(59, 130, 246, 0.2);
      }

      .article-navigation {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .nav-link {
        flex: 1;
        min-width: 200px;
        background: #1e293b;
        border-radius: 12px;
        padding: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid rgba(59, 130, 246, 0.2);
      }

      .nav-link:hover {
        background: #334155;
        border-color: #3b82f6;
      }

      .nav-label {
        font-size: 0.75rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
      }

      .nav-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: #e2e8f0;
      }

      .nav-link:hover .nav-title {
        color: #93c5fd;
      }

      .nav-next {
        text-align: right;
      }

      .article-tags-section {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1rem 0;
      }

      .article-tag-link {
        font-size: 0.75rem;
        padding: 0.2rem 0.7rem;
        background: #1e293b;
        color: #93c5fd;
        text-decoration: none;
        border-radius: 16px;
        transition: all 0.2s ease;
      }

      .article-tag-link:hover {
        background: #334155;
        color: #60a5fa;
      }

      @media (max-width: 768px) {
        .article-navigation {
          flex-direction: column;
        }

        .nav-link {
          text-align: center;
        }

        .nav-next {
          text-align: center;
        }
      }

      @media (max-width: 768px) {
        .team-logo {
          width: 40px;
          height: 40px;
        }

        .team-name {
          font-size: 0.85rem;
        }

        .team-score {
          font-size: 1.8rem;
          min-width: 40px;
        }

        .score-separator {
          font-size: 1rem;
        }
      }
    </style>

  </head>
  <body>
    <Navbar/>
    <div class="container">
      <a href="/" class="back-link">← Back to all articles</a>

      <div class="article-header">
        <h1>{title}</h1>
        <div class="meta">
          {date && <span>📅 {date}</span>}
          {author && <span>✍️ {"Konstantinos Chaldoupis"}</span>}
        </div>
      </div>

      <article>
        <slot />
      <article>

    </div>

    <Footer/>
  </body>
</html>
