---
// List your articles here - newest first
const articles = [
  { 
    slug: "intro", 
    title: "Introduction", 
    date: "2026-05-13" 
  },
];

// Sort by date (newest first)
const sortedArticles = articles.sort((a, b) => new Date(b.date) - new Date(a.date));

// Format date nicely
function formatDate(dateString) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0a1928;		
            color: #e2e8f0;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
        }

        h1 {
            font-size: 3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            color: #94a3b8;
            margin-bottom: 3rem;
            border-left: 3px solid #3b82f6;
            padding-left: 1rem;
        }

        .articles {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .article-card {
            background: rgba(30, 41, 59, 0.5);
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .article-card:hover {
            background: rgba(30, 41, 59, 0.7);
            border-color: #3b82f6;
        }

        .article-card a {
            color: white;
            text-decoration: none;
            font-size: 1.3rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.5rem;
        }

        .article-card a:hover {
            color: #93c5fd;
        }

        .date {
            color: #94a3b8;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1> <span style="color: #fbbf24;">⚽</span> Football Blog</h1>
        <div class="subtitle">Football news, Match analysis & Opinions</div>
        
        <div class="articles">
            {sortedArticles.map(article => (
                <div class="article-card">
                    <a href={`/articles/${article.slug}`}>{article.title}</a>
                    <div class="date">{formatDate(article.date)}</div>
                </div>
            ))}
        </div>
    </div>
</body>
</html>