---
import "../styles/global.css";

interface Article {
  slug: string;
  title: string;
  date: string;
  description: string;
  author?: string;
  pinned?: boolean; // Add this for pinned articles
  tags?: string[]; // to search/filter
}

// List articles here - newest first
const articles: Article[] = [
  {
    slug: "intro",
    title: "Introduction",
    date: "2026-05-13",
    description: "Introduction",
    pinned: true,
  },
  {
    slug: "test",
    title: "Test",
    description: "My first footbal artcle",
    date: "2026-05-13",
  },
];

// Get all unique tags
const allTags: string[] = [...new Set(articles.flatMap(article => article.tags || []))].sort();


// Get current tag from URL (for filtering)
const currentTag: string | null = Astro.url.searchParams.get('tag');


// Filter articles by tag if one is selected
let filteredArticles = [...articles];
if (currentTag) {
  filteredArticles = filteredArticles.filter((article: Article) => 
    article.tags?.includes(currentTag)
  );
}

// Sort: pinned first, then by date
const sortedArticles = filteredArticles.sort((a: Article, b: Article) => {
  if (a.pinned && !b.pinned) return -1;
  if (!a.pinned && b.pinned) return 1;
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

// Format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Football Blog</title>
  </head>
  <body>
    <div class="container">
      <h1>⚽ Football Blog</h1>
      <div class="subtitle">
        Match recaps from the top 5 leagues + other leagues around the world
      </div>

      <!-- Tag Filter Bar
      <div class="tag-bar">
        <a href="/" class={`tag ${!currentTag ? "active" : ""}`}> All Posts </a>
        {
          allTags.map((tag) => (
            <a
              href={`/?tag=${tag}`}
              class={`tag ${currentTag === tag ? "active" : ""}`}
            >
              #{tag}
            </a>
          ))
        }
      </div> -->

      <!-- Show current filter indicator -->
      {
        currentTag && (
          <div class="filter-info">
            Showing posts tagged: <strong>#{currentTag}</strong>
            <a href="/" class="clear-filter">
              ✕ Clear filter
            </a>
          </div>
        )
      }

        <div class="articles">
        {sortedArticles.map((article) => (
            <div class={`article-card ${article.pinned ? 'pinned' : ''}`}>
            {article.pinned && <div class="pinned-badge">📌 PINNED</div>}
            <a href={`/articles/${article.slug}`}>{article.title}</a>
            <div class="date">{formatDate(article.date)}</div>
            {article.tags && article.tags.length > 0 && (
                <div class="article-tags">
                {article.tags.map(tag => (
                    <a href={`/?tag=${tag}`} class="article-tag">#{tag}</a>
                ))}
                </div>
            )}
            </div>
        ))}
        </div>
    </div>
  </body>
</html>
