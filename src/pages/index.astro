---
import "../styles/global.css";
import Navbar from "../components/Astro/Navbar.astro";
import Footer from "../components/Astro/Footer.astro";

interface Article {
  slug: string;
  title: string;
  date: string;
  description: string;
  author?: string;
  pinned?: boolean; 
  tags?: string[]; 
}

// List articles here - newest first
const articles: Article[] = [
    {
    slug: "4",
    title: "World Cup Preview & My thoughts - 5/6/2026",
    date: "2026-06-05",
    description: "World Cup Preview",
  },
  {
    slug: "3",
    title: "Weekend Recap - May 18, 2026",
    date: "2026-05-18",
    description: "Weekend Recap",
  },
  {
    slug: "2",
    title: "Superb European Football Roundup - May 14, 2026",
    date: "2026-05-14",
    description: "Introduction",
  },
  {
    slug: "intro",
    title: "Introduction",
    date: "2026-05-13",
    description: "Introduction",
    pinned: true,
  },
];

// Get all unique tags
const allTags: string[] = [
  ...new Set(articles.flatMap((article) => article.tags || [])),
].sort();

// Get current tag from URL (for filtering)
const currentTag: string | null = Astro.url.searchParams.get("tag");

// Filter articles by tag if one is selected
let filteredArticles = [...articles];
if (currentTag) {
  filteredArticles = filteredArticles.filter((article: Article) =>
    article.tags?.includes(currentTag),
  );
}

// Sort: pinned first, then by date
const sortedArticles = filteredArticles.sort((a: Article, b: Article) => {
  if (a.pinned && !b.pinned) return -1;
  if (!a.pinned && b.pinned) return 1;
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

// Format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-adsense-account" content="ca-pub-2309635489256946">
    <title>Football Blog</title>
  </head>
  <body>
    <Navbar />
    <div class="container">
      <h1>⚽ Football Blog</h1>
      <div class="subtitle">
        Match recaps & football stories from across the globe
      </div>

      <!-- Show current filter indicator -->
      {
        currentTag && (
          <div class="filter-info">
            Showing posts tagged: <strong>#{currentTag}</strong>
            <a href="/" class="clear-filter">
              ✕ Clear filter
            </a>
          </div>
        )
      }

      <div class="articles">
        {
          sortedArticles.map((article) => (
            <div class={`article-card ${article.pinned ? "pinned" : ""}`}>
              {article.pinned && <div class="pinned-badge">📌 PINNED</div>}
              <a href={`/articles/${article.slug}`}>{article.title}</a>
              <div class="date">{formatDate(article.date)}</div>
              {article.tags && article.tags.length > 0 && (
                <div class="article-tags">
                  {article.tags.map((tag) => (
                    <a href={`/?tag=${tag}`} class="article-tag">
                      #{tag}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2309635489256946"
     crossorigin="anonymous"></script>
    <Footer />
  </body>
</html>
