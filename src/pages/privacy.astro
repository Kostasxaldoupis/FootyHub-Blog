---
import Layout from "../layouts/ArticleLayout.astro";
import Navbar from "../components/Astro/Navbar.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privacy Policy | Football Blog</title>
</head>
<body>
    <Navbar />
    <div class="container">
        <h1>Privacy Policy</h1>
        <div class="meta">Last updated: May 14, 2026</div>
        
        <h2>Information We Collect</h2>
        <p>This blog does not collect any personal information. We respect your privacy and are committed to protecting it.</p>
        
        <h2>Cookies</h2>
        <p>This blog does not use cookies for tracking. Any cookies used are strictly for functionality (like remembering language preferences).</p>
        
        <h2>Third-Party Services</h2>
        <p>We do not use any third-party analytics or tracking services.</p>
        
        <h2>Contact</h2>
        <p>If you have any questions about this privacy policy, feel free to reach out.</p>
    </div>
</body>
</html>